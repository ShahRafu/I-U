<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pikachu Security Activation"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp" />

    <EditText
        android:id="@+id/etUserName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="আপনার নাম লিখুন"
        android:textColor="#FFFFFF"
        android:textColorHint="#888888"
        android:backgroundTint="#FF9800"
        android:inputType="textPersonName"
        android:padding="12dp"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/etInitialPin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="৬ অক্ষরের পিন দিন"
        android:textColor="#FFFFFF"
        android:textColorHint="#888888"
        android:backgroundTint="#FF9800"
        android:inputType="numberPassword"
        android:maxLength="6"
        android:padding="12dp"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/etVerificationCode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="৮ অক্ষরের ইউনিক কোড (যেমন: MGa356&amp;%)"
        android:textColor="#FFFFFF"
        android:textColorHint="#888888"
        android:backgroundTint="#FF9800"
        android:inputType="textVisiblePassword"
        android:maxLength="8"
        android:padding="12dp"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnSubmit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ভেরিফাই ও অ্যাক্টিভেট করুন"
        android:backgroundTint="#FF9800"
        android:textColor="#000000"
        android:textStyle="bold"
        android:padding="14dp" />

</LinearLayout>
